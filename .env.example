# =============================================================================
# Donnici Advogados — Variáveis de Ambiente (exemplo)
# Copie para .env e preencha com valores reais. Nunca comite .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://usuario:senha@localhost:5432/donnici?schema=public"

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"
PORT=3000

# -----------------------------------------------------------------------------
# Segurança / Autenticação
# -----------------------------------------------------------------------------
# Segredo para assinatura de sessões/JWT (gerar com: openssl rand -base64 48)
AUTH_SECRET=""
# URL base usada pelo NextAuth (em dev: http://localhost:3000)
AUTH_URL="http://localhost:3000"
# Chave para cifragem simétrica de credenciais de integração (AES-256, 32 bytes em base64)
ENCRYPTION_KEY=""

# -----------------------------------------------------------------------------
# Integração Google (Calendar + Gmail) — OAuth2
# Console: https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/integracoes/google/callback"

# -----------------------------------------------------------------------------
# Integrações com Tribunais (futuro)
# Credenciais por usuário são persistidas cifradas em IntegracaoTribunal.
# Aqui ficam apenas chaves/URLs globais quando aplicável.
# -----------------------------------------------------------------------------
PJE_BASE_URL=""
ESAJ_BASE_URL=""
PROJUDI_BASE_URL=""
EPROC_BASE_URL=""
